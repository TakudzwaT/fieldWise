<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and earlier (android:fullBackupContent).

  Shared preferences hold only flutter_secure_storage's encrypted session and
  the wrapped key for it. The key that unwraps it lives in the Android Keystore
  and never leaves this phone, so a copy restored onto another phone cannot be
  decrypted - it would only make that phone's first launch fail to read its
  session. Excluding it means a restored app starts signed out, cleanly.
  Everything else - the farm database included - is backed up as before.
  Data exports are not written here at all: they go to the cache directory,
  which Android never backs up (see lib/data/account/export_store.dart).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
</full-backup-content>
