<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is denied everywhere except the emulator's route to its host.

  The E2E suite drives a release APK against an API on the developer/CI machine
  at http://10.0.2.2:8000, and Android blocks cleartext by default from API 28,
  so without this the app reports Offline in the online flow and the test fails
  for a reason that has nothing to do with the app.

  Scoping it to these two addresses rather than setting
  android:usesCleartextTraffic="true" keeps the exemption useless in
  production: 10.0.2.2 only means anything inside an Android emulator, and a
  farmer's phone can never reach either address. Every real API call stays
  HTTPS-only, which scripts/mobile-api.mjs independently enforces at build time.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- The emulator's alias for the host machine. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
