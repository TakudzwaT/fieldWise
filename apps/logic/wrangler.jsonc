{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fieldwise-logic",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "triggers": {
    // 15 minutes past each hour, after the weather API's refresh at :05.
    "crons": ["15 * * * *"]
  },
  "vars": {
    "WEATHER_API": "https://fieldwise-api.takudzwamhizha132.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fieldwise-logic",
      // Placeholder for local development. Replace with the id from
      // `wrangler d1 create fieldwise-logic` on the deploy account.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
